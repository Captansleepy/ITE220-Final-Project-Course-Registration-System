# Copy to server/.env and fill values locally. Never commit real secrets.
PORT=5002
CLIENT_ORIGIN=http://localhost:5174
JWT_SECRET=
MONGODB_URI=
MONGODB_DB_NAME=
# Seed only a NEW EMPTY course_registration_seed_<name> database.
SEED_PASSWORD=
# Optional: SEED_FILE=CSC220-Project-Info_final_1.xlsx
# Optional: DNS_SERVERS=8.8.8.8,8.8.4.4
# Password reset emails. "console" prints them in this terminal (development only).
# Leave empty to send nothing. A real email provider is not set up yet.
MAIL_TRANSPORT=console
# Optional: website address used in reset links (defaults to CLIENT_ORIGIN).
# APP_BASE_URL=http://localhost:5174
